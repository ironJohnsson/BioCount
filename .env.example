# Configurações do Banco de Dados Turso (libSQL)
# Obtenha estas credenciais gratuitamente no painel da Turso (https://turso.tech)
# Comando Turso CLI:
#   turso db create biocount-db
#   turso db show biocount-db --url
#   turso db tokens create biocount-db

TURSO_DATABASE_URL=libsql://biocount-db-yourusername.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Porta do Servidor (no Render é atribuída automaticamente)
PORT=3001
NODE_ENV=production

